  "info": {
    "_postman_id": "e05f6c30-25c8-4f97-8584-caa310579efa",
    "name": "Palo Alto Networks Security Advisory API",
    "description": "Public REST API for querying Palo Alto Networks Product Security Incident Response Team (PSIRT) security advisories. Beta release. Provides access to published vulnerability advisories including CVE identifiers, severity ratings, CVSS scores, affected products and versions, fixed versions, and remediation guidance. No authentication is required. Advisory data covers PAN-OS, Cortex XDR, Prisma Cloud, GlobalProtect, and other Palo Alto Networks products.\n\nContact Support:\n Name: Palo Alto Networks Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T13:18:58.000Z",
    "updatedAt": "2026-06-05T13:18:58.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-e05f6c30-25c8-4f97-8584-caa310579efa"
  },
