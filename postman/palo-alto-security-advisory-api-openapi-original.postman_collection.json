                    },
                    {
                      "description": "Filter by affected product name. Examples: PAN-OS, Cortex XDR Agent, Prisma Cloud, GlobalProtect, Cortex XSOAR.",
                      "key": "affected_product",
                      "value": "<string>"
                    },
                    {
                      "description": "Field and direction to sort results by.",
                      "key": "sort",
                      "value": "-publishedDate"
                    },
