                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/advisories/:advisory_id",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "advisories",
                    ":advisory_id"
